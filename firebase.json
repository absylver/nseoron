{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "**/*.@(jpg|png|css|js)", "headers": [{ "key": "Cache-Control", "value": "max-age=3600" }] },
      { "source": "stream.js", "headers": [{ "key": "Cache-Control", "value": "max-age=300" }] }
    ]
  }
}
